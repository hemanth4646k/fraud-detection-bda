FRAUD_DATASET_URL=https://storage.googleapis.com/download.tensorflow.org/data/creditcard.csv
RAW_DATA_PATH=data/raw/creditcard.csv
STREAMING_SEED_PATH=data/processed/streaming_seed.csv
MODEL_ARTIFACT_PATH=data/artifacts/logistic_fraud_model.json
METRICS_PATH=data/artifacts/training_metrics.json

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions
PRODUCER_RATE_PER_SECOND=10
FRAUD_BOOST_FACTOR=25
STREAM_LIMIT=0

SPARK_MASTER=local[*]
SPARK_APP_NAME=fraud-detection-stream
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1
SPARK_SHUFFLE_PARTITIONS=4

CHECKPOINT_DIR=data/outputs/checkpoints
PREDICTIONS_DIR=data/outputs/predictions
ALERTS_DIR=data/outputs/alerts
MIN_ALERT_PROBABILITY=0.75
MODEL_THRESHOLD_OVERRIDE=

S3_ENABLED=true
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fraud-lake
S3_PREDICTIONS_PREFIX=predictions
S3_ALERTS_PREFIX=alerts
S3_REGION=us-east-1

SNOWFLAKE_ENABLED=false
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
SNOWFLAKE_TABLE=FRAUD_PREDICTIONS

DASHBOARD_PREDICTIONS_PATH=data/outputs/predictions
DASHBOARD_ALERTS_PATH=data/outputs/alerts
DASHBOARD_MAX_FILES=
